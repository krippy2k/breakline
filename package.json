
{
  "name": "breakline",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "breakline": "./packages/cli/dist/index.js"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "breakline": "node packages/cli/dist/index.js",
    "dev:github": "pnpm --filter @breakline/server dev",
    "publish:packages": "pnpm -r --filter \"./packages/**\" publish --access public"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
