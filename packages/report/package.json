{
  "name": "@breakline/report",
  "version": "0.4.0",
  "description": "Structured Breakline reports, impact classification, and repository analysis API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krippy2k/breakline.git",
    "directory": "packages/report"
  },
  "bugs": {
    "url": "https://github.com/krippy2k/breakline/issues"
  },
  "homepage": "https://github.com/krippy2k/breakline#readme",
  "keywords": [
    "breakline",
    "report",
    "static-analysis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@breakline/core": "workspace:^",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
